<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0a0d10"><title>VTT — Твой мир, твоя история</title>
<style>
:root{color-scheme:dark;--bg:#080b0e;--panel:#11171d;--line:#27313b;--gold:#d9a84f;--text:#f4f0e8;--muted:#a5adb8}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif}body{display:flex;flex-direction:column;overflow:hidden}.top{display:flex;align-items:center;gap:10px;padding:10px clamp(10px,2vw,26px);min-height:64px;background:rgba(8,11,14,.97);border-bottom:1px solid var(--line);z-index:5}.brand{display:flex;align-items:center;gap:9px;margin-right:auto;white-space:nowrap;color:var(--gold);font-weight:800;font-size:20px;letter-spacing:.04em}.brand-mark{font-size:27px}.nav{display:flex;gap:5px;align-items:center;overflow-x:auto;scrollbar-width:none}.nav button{border:1px solid transparent;background:transparent;color:#c5cbd2;padding:10px 13px;border-radius:9px;white-space:nowrap;font:inherit;cursor:pointer}.nav button:hover{background:#171d23;color:white}.nav button.active{background:#282116;border-color:#4c3a1e;color:#f0c36e}.tools{display:flex;gap:6px}.tools button{background:#11171d;border:1px solid var(--line);color:var(--text);border-radius:9px;padding:9px 11px;cursor:pointer}.viewport{position:relative;flex:1;min-height:0;background:#0b0f13}.app{display:none;width:100%;height:100%;border:0;background:#101318}.app.active{display:block}.mobile-tabs{display:none}@media(max-width:760px){.top{min-height:58px;padding:7px 9px;gap:7px}.brand{font-size:17px}.brand-mark{font-size:23px}.nav{gap:2px}.nav button{padding:8px 9px;font-size:13px}.tools button{padding:8px}.tools .help{display:none}}@media(max-width:520px){.top{flex-wrap:wrap}.brand{width:calc(100% - 80px)}.nav{order:3;width:100%;flex:1}.nav button{flex:1;padding:8px 6px;font-size:12px}.tools{margin-left:auto}.viewport{padding-bottom:env(safe-area-inset-bottom)}}
</style></head><body>
<header class="top"><div class="brand"><span class="brand-mark">⬡</span><span>VTT <small style="display:block;font-size:9px;color:#a5adb8;font-weight:400;letter-spacing:0">VIRTUAL TABLETOP</small></span></div>
<nav class="nav" aria-label="Разделы сайта"><button data-page="home" class="active">Главная</button><button data-page="table" id="tableNavBtn">Игровой стол</button></nav>
<div class="tools"><button class="help" id="helpBtn" title="О проекте">?</button><button id="fullBtn" title="На весь экран">⛶</button></div></header>
<main class="viewport" id="viewport"><iframe class="app active" id="app-home" title="Главная"></iframe><iframe class="app" id="app-table" title="Игровой стол"></iframe><iframe class="app" id="app-characters" title="Персонажи"></iframe><iframe class="app" id="app-bestiary" title="Бестиарий"></iframe></main>
<script>
const sources={"home": "","table": "","characters": "","bestiary": ""};
for(const [key,data] of Object.entries(sources)){const frame=document.getElementById('app-'+key);frame.srcdoc=decodeURIComponent(escape(atob(data)));}

window.__vttActiveSession=null;
window.addEventListener('message',e=>{if(e.data&&e.data.type==='vtt-open-table'&&e.data.sessionId){window.__vttActiveSession={id:String(e.data.sessionId),role:e.data.role||'player',name:e.data.sessionName||'',characterId:e.data.characterId||null,characterName:e.data.characterName||null};showPage('table',true);setTimeout(()=>{const frame=document.getElementById('app-table');if(frame&&frame.contentWindow)frame.contentWindow.postMessage({type:'vtt-session-context',session:window.__vttActiveSession},'*')},100);}});
function showPage(key,fromSuccessfulJoin=false){
 if(key==='table'&&!window.__vttActiveSession){alert('Сначала войди в сессию на главной странице. Чтобы открыть игровой стол, нужно создать сессию или войти в существующую.');key='home';}
 document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===key));
 document.querySelectorAll('.app').forEach(f=>f.classList.toggle('active',f.id==='app-'+key));
 document.title=({home:'VTT — Главная',table:'VTT — Игровой стол'})[key]||'VTT';
 if(key==='table'&&window.__vttActiveSession){const frame=document.getElementById('app-table');try{frame.contentWindow.postMessage({type:'vtt-session-context',session:window.__vttActiveSession},'*')}catch(e){}}
}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
document.getElementById('fullBtn').addEventListener('click',async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen()}catch(e){}});
document.getElementById('helpBtn').addEventListener('click',()=>alert('VTT — виртуальный игровой стол для фэнтези-приключений. На главной странице доступны сессии, персонажи и бестиарий. Игровой стол открывается только после входа в сессию.'));
// Characters and bestiary are kept as tabs inside the main screen. The table can only be opened after a successful session join.
</script></body></html>
